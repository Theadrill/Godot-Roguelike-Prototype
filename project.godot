; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can be edited using the editor's text syntax.

config_version=5

[application]

config/name="Severed Dawn"
config/description="2D Action Roguelike Prototype"
config/version="0.1.0"
run/main_scene="res://src/world/movement_gym.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://src/core/input_setup.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.12, 1)
